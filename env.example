# =============================================================
# VARIABLES DE ENTORNO — Monitor Económico
# =============================================================
# Copiá este archivo como `.env` y completá los valores.
# El archivo `.env` está en .gitignore y NUNCA debe commitearse.
#
# ⚠️  IMPORTANTE — SEGURIDAD:
# Todo lo que empieza con VITE_ se INCRUSTA en el bundle final y es
# PÚBLICO: cualquier visitante puede leerlo desde el navegador.
# Por lo tanto, acá van SOLO datos públicos.
#
# NUNCA pongas acá: claves secretas de API, contraseñas de base de datos,
# tokens de administrador, secretos de pasarelas de pago (MercadoPago,
# Stripe), ni credenciales de servicios de terceros.
# Todo eso vive únicamente en el BACKEND.
# =============================================================

# URL base del backend (dato público)
VITE_API_URL=http://localhost:3000/api

# Usar datos simulados en lugar del backend real.
# true  = modo desarrollo con mocks
# false = pega contra VITE_API_URL
VITE_USE_MOCKS=true
# (dejalo en true hasta que tengas backend; false lo apaga)
