POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host y puerto de Postgres (opcionales, estos son los valores por defecto)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Entorno: development | staging | production
# Obligatoria y sin valor por defecto: si falta, la app no arranca.
ENVIRONMENT=development

# Origen exacto del frontend, usado por CORS. Nunca "*": el navegador
# rechaza el comodin cuando se envian cookies de sesion.
# FRONTEND_ORIGIN=http://localhost:5173

# URL publica de este backend, usada para armar los links de verificacion
# y de reset. En produccion hay que definirla si o si.
# PUBLIC_BASE_URL=http://localhost:8000

# Sesiones
# SESSION_COOKIE_NAME=monitor_session
# SESSION_LIFETIME_DAYS=30

# Vencimiento de los tokens de un solo uso
# VERIFICATION_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=60

# Si esta en true, no se puede usar la cuenta sin verificar el email.
# Requiere un proveedor de mail configurado. Dejar en false hasta la Fase 4.
# EMAIL_VERIFICATION_REQUIRED=false

# Version de los terminos y condiciones que el servidor registra al aceptar.
# La fija el servidor, nunca el cliente (Ley 25.326).
# TERMS_VERSION=1.0

# Horas que se sostiene el precio de una preferencia de pago antes de
# vencer. 24 es una decision de negocio (FASE-4.md 6.4), no un limite
# tecnico.
# CHECKOUT_PREFERENCE_TTL_HOURS=24
